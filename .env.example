GROQ_API_KEY=<your_groq_api_key_here>
GROQ_MODEL=openai/gpt-oss-20b
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CapstoneCore
DB_RO_USER=capstone_ro
DB_RO_PASSWORD=<enter_password>

# backend-php: base URL of the FastAPI service it proxies to
FASTAPI_BASE_URL=http://127.0.0.1:8000
# backend-php: origin allowed to call it via CORS (Vite dev server default)
PHP_CORS_ALLOWED_ORIGIN=http://localhost:5173
